{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirosim/population_frame.schema.json",
  "title": "PopulationFrame",
  "description": "人群框架：这批虚拟人代表现实中的谁、各分群占多大比例、各抽多少人。",
  "type": "object",
  "required": ["frame_id", "universe", "share_basis", "segments", "diversity", "mbti_prior"],
  "additionalProperties": false,
  "$defs": {
    "nonNegativeWeight": {"type": "number", "minimum": 0},
    "genderMarginal": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "male": {"$ref": "#/$defs/nonNegativeWeight"},
        "female": {"$ref": "#/$defs/nonNegativeWeight"},
        "other": {"$ref": "#/$defs/nonNegativeWeight"}
      },
      "anyOf": [
        {"required": ["male"], "properties": {"male": {"exclusiveMinimum": 0}}},
        {"required": ["female"], "properties": {"female": {"exclusiveMinimum": 0}}},
        {"required": ["other"], "properties": {"other": {"exclusiveMinimum": 0}}}
      ]
    },
    "educationMarginal": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "primary": {"$ref": "#/$defs/nonNegativeWeight"},
        "junior_high": {"$ref": "#/$defs/nonNegativeWeight"},
        "senior_high": {"$ref": "#/$defs/nonNegativeWeight"},
        "college": {"$ref": "#/$defs/nonNegativeWeight"},
        "bachelor": {"$ref": "#/$defs/nonNegativeWeight"},
        "master_plus": {"$ref": "#/$defs/nonNegativeWeight"}
      },
      "anyOf": [
        {"required": ["primary"], "properties": {"primary": {"exclusiveMinimum": 0}}},
        {"required": ["junior_high"], "properties": {"junior_high": {"exclusiveMinimum": 0}}},
        {"required": ["senior_high"], "properties": {"senior_high": {"exclusiveMinimum": 0}}},
        {"required": ["college"], "properties": {"college": {"exclusiveMinimum": 0}}},
        {"required": ["bachelor"], "properties": {"bachelor": {"exclusiveMinimum": 0}}},
        {"required": ["master_plus"], "properties": {"master_plus": {"exclusiveMinimum": 0}}}
      ]
    },
    "regionTierMarginal": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "tier1": {"$ref": "#/$defs/nonNegativeWeight"},
        "new_tier1": {"$ref": "#/$defs/nonNegativeWeight"},
        "tier2": {"$ref": "#/$defs/nonNegativeWeight"},
        "tier3_below": {"$ref": "#/$defs/nonNegativeWeight"},
        "county": {"$ref": "#/$defs/nonNegativeWeight"},
        "rural": {"$ref": "#/$defs/nonNegativeWeight"}
      },
      "anyOf": [
        {"required": ["tier1"], "properties": {"tier1": {"exclusiveMinimum": 0}}},
        {"required": ["new_tier1"], "properties": {"new_tier1": {"exclusiveMinimum": 0}}},
        {"required": ["tier2"], "properties": {"tier2": {"exclusiveMinimum": 0}}},
        {"required": ["tier3_below"], "properties": {"tier3_below": {"exclusiveMinimum": 0}}},
        {"required": ["county"], "properties": {"county": {"exclusiveMinimum": 0}}},
        {"required": ["rural"], "properties": {"rural": {"exclusiveMinimum": 0}}}
      ]
    },
    "incomeBandMarginal": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "lt_50k": {"$ref": "#/$defs/nonNegativeWeight"},
        "50k_100k": {"$ref": "#/$defs/nonNegativeWeight"},
        "100k_200k": {"$ref": "#/$defs/nonNegativeWeight"},
        "200k_500k": {"$ref": "#/$defs/nonNegativeWeight"},
        "gt_500k": {"$ref": "#/$defs/nonNegativeWeight"}
      },
      "anyOf": [
        {"required": ["lt_50k"], "properties": {"lt_50k": {"exclusiveMinimum": 0}}},
        {"required": ["50k_100k"], "properties": {"50k_100k": {"exclusiveMinimum": 0}}},
        {"required": ["100k_200k"], "properties": {"100k_200k": {"exclusiveMinimum": 0}}},
        {"required": ["200k_500k"], "properties": {"200k_500k": {"exclusiveMinimum": 0}}},
        {"required": ["gt_500k"], "properties": {"gt_500k": {"exclusiveMinimum": 0}}}
      ]
    },
    "regionMarginal": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "northeast": {"$ref": "#/$defs/nonNegativeWeight"},
        "beijing_tianjin": {"$ref": "#/$defs/nonNegativeWeight"},
        "north_other": {"$ref": "#/$defs/nonNegativeWeight"},
        "northwest": {"$ref": "#/$defs/nonNegativeWeight"},
        "shandong": {"$ref": "#/$defs/nonNegativeWeight"},
        "central": {"$ref": "#/$defs/nonNegativeWeight"},
        "jiangzhe": {"$ref": "#/$defs/nonNegativeWeight"},
        "shanghai": {"$ref": "#/$defs/nonNegativeWeight"},
        "fujian": {"$ref": "#/$defs/nonNegativeWeight"},
        "guangdong": {"$ref": "#/$defs/nonNegativeWeight"},
        "sichuan_chongqing": {"$ref": "#/$defs/nonNegativeWeight"},
        "yungui": {"$ref": "#/$defs/nonNegativeWeight"}
      },
      "anyOf": [
        {"required": ["northeast"], "properties": {"northeast": {"exclusiveMinimum": 0}}},
        {"required": ["beijing_tianjin"], "properties": {"beijing_tianjin": {"exclusiveMinimum": 0}}},
        {"required": ["north_other"], "properties": {"north_other": {"exclusiveMinimum": 0}}},
        {"required": ["northwest"], "properties": {"northwest": {"exclusiveMinimum": 0}}},
        {"required": ["shandong"], "properties": {"shandong": {"exclusiveMinimum": 0}}},
        {"required": ["central"], "properties": {"central": {"exclusiveMinimum": 0}}},
        {"required": ["jiangzhe"], "properties": {"jiangzhe": {"exclusiveMinimum": 0}}},
        {"required": ["shanghai"], "properties": {"shanghai": {"exclusiveMinimum": 0}}},
        {"required": ["fujian"], "properties": {"fujian": {"exclusiveMinimum": 0}}},
        {"required": ["guangdong"], "properties": {"guangdong": {"exclusiveMinimum": 0}}},
        {"required": ["sichuan_chongqing"], "properties": {"sichuan_chongqing": {"exclusiveMinimum": 0}}},
        {"required": ["yungui"], "properties": {"yungui": {"exclusiveMinimum": 0}}}
      ]
    },
    "motiveTypeMarginal": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "self_interest": {"$ref": "#/$defs/nonNegativeWeight"},
        "rational": {"$ref": "#/$defs/nonNegativeWeight"},
        "impulsive": {"$ref": "#/$defs/nonNegativeWeight"},
        "herd": {"$ref": "#/$defs/nonNegativeWeight"},
        "procedural": {"$ref": "#/$defs/nonNegativeWeight"},
        "idealist": {"$ref": "#/$defs/nonNegativeWeight"},
        "cautious": {"$ref": "#/$defs/nonNegativeWeight"},
        "radical": {"$ref": "#/$defs/nonNegativeWeight"}
      },
      "anyOf": [
        {"required": ["self_interest"], "properties": {"self_interest": {"exclusiveMinimum": 0}}},
        {"required": ["rational"], "properties": {"rational": {"exclusiveMinimum": 0}}},
        {"required": ["impulsive"], "properties": {"impulsive": {"exclusiveMinimum": 0}}},
        {"required": ["herd"], "properties": {"herd": {"exclusiveMinimum": 0}}},
        {"required": ["procedural"], "properties": {"procedural": {"exclusiveMinimum": 0}}},
        {"required": ["idealist"], "properties": {"idealist": {"exclusiveMinimum": 0}}},
        {"required": ["cautious"], "properties": {"cautious": {"exclusiveMinimum": 0}}},
        {"required": ["radical"], "properties": {"radical": {"exclusiveMinimum": 0}}}
      ]
    }
  },
  "properties": {
    "frame_id": {"type": "string", "pattern": "^f_[0-9a-z_]+$"},
    "universe": {"type": "string", "description": "代表的现实人群，一句话"},
    "share_basis": {"type": "string", "description": "各分群占比的依据（统计口径、调研来源或'配置人估计'）。必须填写，报告原样引用。"},
    "segments": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["segment_id", "label", "filter", "share", "n"], "additionalProperties": false,
        "properties": {
          "segment_id": {"type": "string"},
          "label": {"type": "string"},
          "filter": {"type": "object", "description": "人物卡字段条件，键为点路径，值为允许取值列表", "additionalProperties": {"type": "array"}},
          "marginals": {
            "type": "object", "description": "分群内字段的边际分布；省略时均匀抽样",
            "additionalProperties": false,
            "properties": {
              "identity.gender": {"$ref": "#/$defs/genderMarginal"},
              "identity.education": {"$ref": "#/$defs/educationMarginal"},
              "identity.region_tier": {"$ref": "#/$defs/regionTierMarginal"},
              "identity.income_band": {"$ref": "#/$defs/incomeBandMarginal"},
              "identity.home_region": {"$ref": "#/$defs/regionMarginal"},
              "identity.residence_region": {"$ref": "#/$defs/regionMarginal"},
              "psyche.motive_type": {"$ref": "#/$defs/motiveTypeMarginal"}
            }
          },
          "share": {"type": "number", "minimum": 0, "maximum": 1, "description": "该分群在 universe 中的占比，全体合计为 1"},
          "n": {"type": "integer", "minimum": 1, "description": "抽取人数。可与 share 不成比例（小群体超额抽样），分析时用 share/(n/N) 加权"},
          "quadrant": {"enum": ["core", "appease", "inform", "minor"], "description": "政策包：v3.0 §4.3 相关方四象限"},
          "impact": {
            "type": "object", "description": "政策包：v3.0 §5.17 影响权重三因子输入", "additionalProperties": false,
            "required": ["depth", "alternatives", "irreversibility", "basis"],
            "properties": {
              "depth": {"type": "integer", "minimum": 1, "maximum": 5},
              "alternatives": {"type": "integer", "minimum": 0, "maximum": 4},
              "irreversibility": {"enum": [0.3, 0.6, 1.0]},
              "basis": {"type": "string"}
            }
          }
        }
      }
    },
    "diversity": {
      "type": "object", "required": ["spread_fields", "min_stance_spread_per_segment"], "additionalProperties": false,
      "properties": {
        "spread_fields": {"type": "array", "items": {"type": "string"}, "description": "分群内需拉开的字段，抽样时做最大化覆盖"},
        "min_stance_spread_per_segment": {"type": "integer", "minimum": 1, "description": "n≥4 的分群里，初始倾向至少覆盖几档（反脸谱化）"}
      }
    },
    "mbti_prior": {
      "type": "object", "required": ["mode", "source"], "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["uniform", "table"]},
        "table": {"type": "object", "additionalProperties": {"type": "number"}},
        "source": {"type": "string", "description": "分布来源。uniform 仅用于冒烟测试，正式实验须给出有出处的分布"}
      }
    }
  }
}
